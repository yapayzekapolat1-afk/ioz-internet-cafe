name: Build Android APK

# Bu workflow, "npx cap add android" ve Android Studio derlemesini SENİN
# bilgisayarında değil, GitHub'ın kendi sunucularında otomatik yapar.
# Sonunda Play Store'a yüklenebilir, İMZALI bir .aab dosyası üretir.
#
# ÇALIŞTIRMA: Actions sekmesi -> "Build Android APK" -> "Run workflow"
# butonuna basman yeterli. main dalına her push yaptığında da otomatik
# çalışır.

on:
  push:
    branches: [ main ]
  workflow_dispatch: {}

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - name: Kodu indir
        uses: actions/checkout@v4

      - name: Node.js kur
        uses: actions/setup-node@v4
        with:
          node-version: '22'

      - name: Java (JDK 21) kur
        uses: actions/setup-java@v4
        with:
          distribution: 'temurin'
          java-version: '21'

      - name: Capacitor bağımlılıklarını kur
        run: npm install

      - name: Android projesini oluştur
        run: npx cap add android

      - name: Unity Ads eklentisini native projeye yerleştir
        run: |
          APP_ID=$(node -e "console.log(require('./capacitor.config.json').appId)")
          PKG_PATH="android/app/src/main/java/$(echo $APP_ID | tr '.' '/')"
          echo "Uygulama paketi: $APP_ID -> $PKG_PATH"
          mkdir -p "$PKG_PATH"

          sed "s/^package .*/package $APP_ID;/" android-plugin/UnityAdsBridge.kt > "$PKG_PATH/UnityAdsBridge.kt"

          cat > "$PKG_PATH/MainActivity.java" << EOF
          package $APP_ID;

          import android.os.Bundle;
          import com.getcapacitor.BridgeActivity;

          public class MainActivity extends BridgeActivity {
              @Override
              public void onCreate(Bundle savedInstanceState) {
                  registerPlugin(UnityAdsBridge.class);
                  super.onCreate(savedInstanceState);
              }
          }
          EOF

      - name: Kotlin desteğini Android projesine ekle
        run: |
          ROOT_GRADLE="android/build.gradle"
          if ! grep -q "kotlin-gradle-plugin" "$ROOT_GRADLE"; then
            sed -i "s/classpath 'com.android.tools.build:gradle:[^']*'/&\n        classpath \"org.jetbrains.kotlin:kotlin-gradle-plugin:1.9.24\"/" "$ROOT_GRADLE"
          fi

          APP_GRADLE="android/app/build.gradle"
          if ! grep -q "kotlin-android" "$APP_GRADLE"; then
            sed -i "s/apply plugin: 'com.android.application'/apply plugin: 'com.android.application'\napply plugin: 'kotlin-android'/" "$APP_GRADLE"
          fi

      - name: Unity Ads Gradle bağımlılığını ekle
        run: |
          GRADLE_FILE="android/app/build.gradle"
          if ! grep -q "com.unity3d.ads:unity-ads" "$GRADLE_FILE"; then
            sed -i "s/implementation project(':capacitor-android')/implementation project(':capacitor-android')\n    implementation 'com.unity3d.ads:unity-ads:4.16.6'/" "$GRADLE_FILE"
          fi

      - name: İnternet izinlerini garantile
        run: |
          MANIFEST="android/app/src/main/AndroidManifest.xml"
          if ! grep -q "ACCESS_NETWORK_STATE" "$MANIFEST"; then
            sed -i 's#<uses-permission android:name="android.permission.INTERNET" />#<uses-permission android:name="android.permission.INTERNET" />\n    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />#' "$MANIFEST"
          fi

      - name: Uygulama ikonunu yerleştir
        run: |
          for dir in mdpi hdpi xhdpi xxhdpi xxxhdpi; do
            cp "android-icons/mipmap-$dir/ic_launcher.png" "android/app/src/main/res/mipmap-$dir/ic_launcher.png"
            cp "android-icons/mipmap-$dir/ic_launcher_round.png" "android/app/src/main/res/mipmap-$dir/ic_launcher_round.png"
          done
          ANYDPI="android/app/src/main/res/mipmap-anydpi-v26"
          if [ -d "$ANYDPI" ]; then rm -f "$ANYDPI"/*.xml; fi

      - name: Web dosyalarını native projeye senkronize et
        run: npx cap sync android

      - name: Keystore'u oluştur
        run: |
          echo "${{ secrets.KEYSTORE_BASE64 }}" | base64 -d > android/app/release-key.jks

      - name: İmzalama ayarlarını build.gradle'a ekle
        run: |
          APP_GRADLE="android/app/build.gradle"

          if ! grep -q "signingConfigs" "$APP_GRADLE"; then
            sed -i "/android {/a\\
    signingConfigs {\\
        release {\\
            storeFile file('release-key.jks')\\
            storePassword System.getenv('KEYSTORE_PASSWORD')\\
            keyAlias System.getenv('KEY_ALIAS')\\
            keyPassword System.getenv('KEY_PASSWORD')\\
        }\\
    }" "$APP_GRADLE"
          fi

          if ! grep -q "signingConfig signingConfigs.release" "$APP_GRADLE"; then
            sed -i "0,/release {/{s/release {/release {\n            signingConfig signingConfigs.release/}" "$APP_GRADLE"
          fi

          echo "----- app/build.gradle (kontrol) -----"
          cat "$APP_GRADLE"

      - name: AAB derle (Release, imzalı) — Play Store için
        working-directory: android
        env:
          KEYSTORE_PASSWORD: ${{ secrets.KEYSTORE_PASSWORD }}
          KEY_ALIAS: ${{ secrets.KEY_ALIAS }}
          KEY_PASSWORD: ${{ secrets.KEY_PASSWORD }}
        run: |
          chmod +x gradlew
          ./gradlew bundleRelease

      - name: APK derle (Release, imzalı) — test için telefona kurulabilir
        working-directory: android
        env:
          KEYSTORE_PASSWORD: ${{ secrets.KEYSTORE_PASSWORD }}
          KEY_ALIAS: ${{ secrets.KEY_ALIAS }}
          KEY_PASSWORD: ${{ secrets.KEY_PASSWORD }}
        run: ./gradlew assembleRelease

      - name: AAB'yi yükle (Play Store'a bunu yükleyeceksin)
        uses: actions/upload-artifact@v4
        with:
          name: ioz-internet-cafe-release-aab
          path: android/app/build/outputs/bundle/release/*.aab

      - name: APK'yı yükle (telefonuna test için kur)
        uses: actions/upload-artifact@v4
        with:
          name: ioz-internet-cafe-release-apk
          path: android/app/build/outputs/apk/release/app-release.apk
